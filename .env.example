# ─────────────────────────────────────────────────────────────
# Slicer AI Copilot — LLM configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (or export the variables in your shell
# BEFORE launching 3D Slicer) and fill in your credentials.
#
#   NEVER commit a real API key. This template is the only file
#   that should ever be tracked in version control.
# ─────────────────────────────────────────────────────────────


# ── Provider ────────────────────────────────────────────────
# One of: modelscope | gemini | openai
# Any other value works as long as it has an entry in
# PROVIDER_CONFIGS (llm_client.py) or you also set LLM_BASE_URL.
LLM_PROVIDER=gemini


# ── API key (required) ──────────────────────────────────────
# Get one from the provider you selected above.
LLM_API_KEY=your-api-key-here


# ── Endpoint (optional) ─────────────────────────────────────
# Defaults per provider:
#   modelscope  https://api-inference.modelscope.ai/v1
#   gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   openai      https://api.openai.com/v1
#
# Uncomment to override, or to point at any OpenAI-compatible
# endpoint (Ollama, vLLM, LM Studio, Together, Groq, ...):
# LLM_BASE_URL=https://api.example.com/v1


# ── Model (optional) ────────────────────────────────────────
# Defaults per provider:
#   modelscope  Qwen/Qwen3.5-9B
#   gemini      gemini-2.5-flash
#   openai      gpt-4o
#
# Model availability depends on your account and region.
# Always confirm the id is valid for YOUR credential.
# LLM_MODEL=gemini-2.5-flash


# ─────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────
#
# • Resolution order is: explicit argument → environment → provider default.
# • The in-app ⚙ Settings panel writes to ~/.slicer_ai_copilot/settings.json
#   (plaintext, outside this repository) and takes effect immediately —
#   no restart needed.
# • Environment variables must be set BEFORE launching Slicer; the
#   panel only writes to its own settings file, not to your shell.
# • Prefer environment variables on shared or clinical workstations.
# • Only scene metadata (node names, types, visibility, opacity, colour)
#   is transmitted. Image pixels and DICOM tags never leave the machine.